#!/bin/bash
# =============================================================================
# LearnAgenticAI — Pre-Commit Security & Quality Hook
# Enforced by: Security Agent (agent/security)
# =============================================================================

set -e
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

echo -e "${YELLOW}🔐 Running pre-commit security and quality checks...${NC}"

# --- 1. SECRET SCANNING ---
echo -e "\n📡 Scanning for secrets and credentials..."
if command -v detect-secrets &>/dev/null; then
    detect-secrets scan --baseline .secrets.baseline 2>/dev/null || {
        echo -e "${RED}❌ BLOCKED: Potential secrets detected. Run: detect-secrets audit .secrets.baseline${NC}"
        exit 1
    }
    echo -e "${GREEN}✅ No secrets detected${NC}"
else
    echo -e "${YELLOW}⚠️  detect-secrets not installed. Install: pip install detect-secrets${NC}"
fi

# --- 2. HARDCODED STRING CHECK ---
echo -e "\n🔍 Checking for hardcoded API keys and passwords..."
PATTERNS="(api_key|apikey|api_secret|password|passwd|secret|private_key|access_token)"
STAGED_FILES=$(git diff --cached --name-only | grep -E '\.(kt|java|yml|properties)$' || true)
if [ -n "$STAGED_FILES" ]; then
    if git diff --cached -- $STAGED_FILES | grep -iE "=$PATTERNS\s*=\s*['\"][^'\"]{8,}" 2>/dev/null; then
        echo -e "${RED}❌ BLOCKED: Possible hardcoded secret found in staged files${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}✅ No hardcoded strings detected${NC}"

# --- 3. ANDROID: KTLINT ---
echo -e "\n🎨 Running Ktlint formatting check (Android)..."
if [ -f "./gradlew" ]; then
    ./gradlew ktlintCheck --quiet 2>/dev/null && echo -e "${GREEN}✅ Ktlint passed${NC}" || {
        echo -e "${RED}❌ BLOCKED: Ktlint formatting errors found. Run: ./gradlew ktlintFormat${NC}"
        exit 1
    }
fi

# --- 4. ANDROID: DETEKT ---
echo -e "\n🔬 Running Detekt static analysis (Android)..."
if [ -f "./gradlew" ]; then
    ./gradlew detekt --quiet 2>/dev/null && echo -e "${GREEN}✅ Detekt passed${NC}" || {
        echo -e "${RED}❌ BLOCKED: Detekt found code issues. Review detekt report.${NC}"
        exit 1
    }
fi

# --- 4.5. BACKEND: MAVEN VERIFY ---
echo -e "\n☕ Running Backend Maven Check..."
if [ -f "backend/mvnw" ]; then
    (cd backend && ./mvnw checkstyle:check --quiet 2>/dev/null) && echo -e "${GREEN}✅ Checkstyle passed${NC}" || {
        echo -e "${YELLOW}⚠️  Checkstyle failed or not configured yet.${NC}"
    }
fi

# --- 5. CONVENTIONAL COMMITS CHECK ---
echo -e "\n📝 Validating commit message format..."
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
    if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|test|docs|chore|ci|security|refactor|perf|build)(\([a-z-]+\))?: .{1,100}"; then
        echo -e "${RED}❌ BLOCKED: Invalid commit message format.${NC}"
        echo -e "${YELLOW}   Required: type(scope): description${NC}"
        echo -e "${YELLOW}   Example:  feat(compose): add AgentCard composable${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Commit message format valid${NC}"
fi

echo -e "\n${GREEN}🎉 All pre-commit checks passed! Committing...${NC}\n"
